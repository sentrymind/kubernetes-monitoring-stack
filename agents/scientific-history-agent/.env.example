# Пример конфигурации переменных окружения для Scientific History Agent

# Semantic Scholar API Key (опционально)
# Получить: https://www.semanticscholar.org/product/api
# Лимиты: 5000 запросов/день (бесплатно)
SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_key_here

# CORE API Key (опционально, но рекомендуется)
# Получить: https://core.ac.uk/services/api
# Лимиты: 10000 запросов/месяц (бесплатно)
CORE_API_KEY=your_core_api_key_here

# Настройки логирования
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# Настройки прокси (если требуется)
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=https://proxy.example.com:8080
